diff --git a/datafusion/datasource-parquet/src/scratch_timing.rs b/datafusion/datasource-parquet/src/scratch_timing.rs
new file mode 100644
index 000000000..0399bbe17
--- /dev/null
+++ b/datafusion/datasource-parquet/src/scratch_timing.rs
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: See the NOTICE file distributed with this work for additional information regarding copyright ownership
+// SPDX-FileContributor: Licensed to the Apache Software Foundation (ASF) under one or more contributor license agreements
+
+// Linux-only scratch experiment. Timed closures do not await or move threads.
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::time::Instant;
+
+static ENABLED: OnceLock<bool> = OnceLock::new();
+fn enabled() -> bool {
+    *ENABLED.get_or_init(|| std::env::var_os("MORSEL_SCRATCH_PROFILE").is_some())
+}
+
+fn thread_cpu_ns() -> u64 {
+    #[repr(C)]
+    struct Timespec {
+        sec: i64,
+        nsec: i64,
+    }
+    unsafe extern "C" {
+        fn clock_gettime(id: i32, tp: *mut Timespec) -> i32;
+    }
+    let mut tp = Timespec { sec: 0, nsec: 0 };
+    assert_eq!(unsafe { clock_gettime(3, &mut tp) }, 0);
+    tp.sec as u64 * 1_000_000_000 + tp.nsec as u64
+}
+
+pub struct Phase {
+    calls: AtomicU64,
+    elapsed_ns: AtomicU64,
+    cpu_ns: AtomicU64,
+}
+
+impl Phase {
+    const fn new() -> Self {
+        Self {
+            calls: AtomicU64::new(0),
+            elapsed_ns: AtomicU64::new(0),
+            cpu_ns: AtomicU64::new(0),
+        }
+    }
+
+    pub fn measure<T>(&self, f: impl FnOnce() -> T) -> T {
+        if !enabled() {
+            return f();
+        }
+        let cpu = thread_cpu_ns();
+        let start = Instant::now();
+        let result = f();
+        let elapsed = start.elapsed().as_nanos() as u64;
+        self.cpu_ns.fetch_add(thread_cpu_ns() - cpu, Relaxed);
+        self.elapsed_ns.fetch_add(elapsed, Relaxed);
+        self.calls.fetch_add(1, Relaxed);
+        result
+    }
+}
+
+pub async fn io<T>(phase: &Phase, f: impl Future<Output = T>) -> T {
+    if !enabled() {
+        return f.await;
+    }
+    let start = Instant::now();
+    let result = f.await;
+    phase
+        .elapsed_ns
+        .fetch_add(start.elapsed().as_nanos() as u64, Relaxed);
+    phase.calls.fetch_add(1, Relaxed);
+    result
+}
+
+pub static BATCH: Phase = Phase::new();
+pub static READER: Phase = Phase::new();
+pub static PROJECT: Phase = Phase::new();
+pub static RANGE: Phase = Phase::new();
+
+pub fn snapshot() -> [(&'static str, u64, u64, u64); 4] {
+    [
+        ("batch", &BATCH),
+        ("reader", &READER),
+        ("project", &PROJECT),
+        ("range", &RANGE),
+    ]
+    .map(|(key, p)| {
+        (
+            key,
+            p.calls.load(Relaxed),
+            p.elapsed_ns.load(Relaxed),
+            p.cpu_ns.load(Relaxed),
+        )
+    })
+}
