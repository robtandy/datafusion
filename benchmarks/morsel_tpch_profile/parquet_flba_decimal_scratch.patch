+#[inline]
+fn decode_be_i128(b: &[u8]) -> i128 {
+    if b.len() == 7 {
+        let sign: u8 = if (b[0] & 0x80) != 0 { 0xFF } else { 0x00 };
+        let bytes = [sign, b[0], b[1], b[2], b[3], b[4], b[5], b[6]];
+        i64::from_be_bytes(bytes) as i128
+    } else {
+        i128::from_be_bytes(sign_extend_be(b))
+    }
+}
