+struct Decimal128ValueDecoder {
+    byte_length: usize,
+    dict_i128: Vec<i128>,
+    decoder: Option<Decoder>,
+}
+
+impl ColumnValueDecoder for Decimal128ValueDecoder {
+    type Buffer = Vec<i128>;
+
+    fn new(col: &ColumnDescPtr) -> Self {
+        Self {
+            byte_length: col.type_length() as usize,
+            dict_i128: Vec::new(),
+            decoder: None,
+        }
+    }
+
+    fn set_dict(
+        &mut self,
+        buf: Bytes,
+        num_values: u32,
+        encoding: Encoding,
+        _is_sorted: bool,
+    ) -> Result<()> {
+        if !matches!(
+            encoding,
+            Encoding::PLAIN | Encoding::RLE_DICTIONARY | Encoding::PLAIN_DICTIONARY
+        ) {
+            return Err(nyi_err!(
+                "Invalid/Unsupported encoding type for dictionary: {}",
+                encoding
+            ));
+        }
+        let buf = normalize_fixed_len_byte_array_payload(
+            buf,
+            num_values as usize,
+            self.byte_length,
+            "dictionary page",
+        )?;
+        self.dict_i128.clear();
+        self.dict_i128.reserve(num_values as usize);
+        if self.byte_length > 0 {
+            for chunk in buf.chunks_exact(self.byte_length) {
+                self.dict_i128.push(decode_be_i128(chunk));
+            }
+        }
+        Ok(())
+    }
+
+    fn set_data(
+        &mut self,
+        encoding: Encoding,
+        data: Bytes,
+        num_levels: usize,
+        num_values: Option<usize>,
+    ) -> Result<()> {
+        self.decoder = Some(match encoding {
+            Encoding::PLAIN => Decoder::Plain {
+                buf: data,
+                offset: 0,
+            },
+            Encoding::RLE_DICTIONARY | Encoding::PLAIN_DICTIONARY => Decoder::Dict {
+                decoder: DictIndexDecoder::new(data, num_levels, num_values)?,
+            },
+            Encoding::DELTA_BYTE_ARRAY => Decoder::Delta {
+                decoder: DeltaByteArrayDecoder::new(data)?,
+            },
+            Encoding::BYTE_STREAM_SPLIT => Decoder::ByteStreamSplit {
+                buf: data,
+                offset: 0,
+            },
+            _ => {
+                return Err(general_err!(
+                    "unsupported encoding for fixed length byte array: {}",
+                    encoding
+                ));
+            }
+        });
+        Ok(())
+    }
+
+    fn read(&mut self, out: &mut Self::Buffer, num_values: usize) -> Result<usize> {
+        if self.byte_length == 0 {
+            out.resize(out.len() + num_values, 0);
+            return Ok(num_values);
+        }
+        match self.decoder.as_mut().unwrap() {
+            Decoder::Dict { decoder } => {
+                let dict = &self.dict_i128;
+                if dict.is_empty() {
+                    return Ok(0);
+                }
+                decoder.read(num_values, |keys| {
+                    out.reserve(keys.len());
+                    for &key in keys {
+                        out.push(dict[key as usize]);
+                    }
+                    Ok(())
+                })
+            }
+            Decoder::Plain { offset, buf } => {
+                let to_read =
+                    (num_values * self.byte_length).min(buf.len() - *offset) / self.byte_length;
+                let end_offset = *offset + to_read * self.byte_length;
+                out.reserve(to_read);
+                for chunk in buf.as_ref()[*offset..end_offset].chunks_exact(self.byte_length) {
+                    out.push(decode_be_i128(chunk));
+                }
+                *offset = end_offset;
+                Ok(to_read)
+            }
+            Decoder::Delta { decoder } => {
+                let to_read = num_values.min(decoder.remaining());
+                out.reserve(to_read);
+                decoder.read(to_read, |slice| {
+                    if slice.len() != self.byte_length {
+                        return Err(general_err!(
+                            "encountered array with incorrect length, got {} expected {}",
+                            slice.len(),
+                            self.byte_length
+                        ));
+                    }
+                    out.push(decode_be_i128(slice));
+                    Ok(())
+                })
+            }
+            Decoder::ByteStreamSplit { buf, offset } => {
+                let total_values = buf.len() / self.byte_length;
+                let to_read = num_values.min(total_values - *offset);
+                let mut tmp = Vec::with_capacity(to_read * self.byte_length);
+                read_byte_stream_split(&mut tmp, buf, *offset, to_read, self.byte_length);
+                out.reserve(to_read);
+                for chunk in tmp.chunks_exact(self.byte_length) {
+                    out.push(decode_be_i128(chunk));
+                }
+                *offset += to_read;
+                Ok(to_read)
+            }
+        }
+    }
+
+    fn skip_values(&mut self, num_values: usize) -> Result<usize> {
+        if self.byte_length == 0 {
+            return Ok(num_values);
+        }
+        match self.decoder.as_mut().unwrap() {
+            Decoder::Plain { offset, buf } => {
+                let to_read = num_values.min((buf.len() - *offset) / self.byte_length);
+                *offset += to_read * self.byte_length;
+                Ok(to_read)
+            }
+            Decoder::Dict { decoder } => decoder.skip(num_values),
+            Decoder::Delta { decoder } => decoder.skip(num_values),
+            Decoder::ByteStreamSplit { offset, buf } => {
+                let total_values = buf.len() / self.byte_length;
+                let to_read = num_values.min(total_values - *offset);
+                *offset += to_read;
+                Ok(to_read)
+            }
+        }
+    }
+}
