+fn eval_bool_mask(
+    batch: &RecordBatch,
+    predicate: &Arc<dyn PhysicalExpr>,
+) -> Result<Option<BooleanArray>> {
+    match predicate.evaluate(batch)? {
+        ColumnarValue::Scalar(ScalarValue::Boolean(Some(true))) => Ok(None),
+        ColumnarValue::Scalar(ScalarValue::Boolean(Some(false) | None)) => {
+            Ok(Some(BooleanArray::from(vec![false; batch.num_rows()])))
+        }
+        ColumnarValue::Scalar(_) => {
+            internal_err!("Cannot create filter_array from non-boolean predicates")
+        }
+        ColumnarValue::Array(array) => {
+            let Ok(mask) = as_boolean_array(&array) else {
+                return internal_err!(
+                    "Cannot create filter_array from non-boolean predicates"
+                );
+            };
+            Ok(Some(mask.clone()))
+        }
+    }
+}
