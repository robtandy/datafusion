+fn count_filtered_rows_short_circuit(
+    batch: &RecordBatch,
+    predicate: &Arc<dyn PhysicalExpr>,
+) -> Result<usize> {
+    let groups = group_and_order_conjuncts(batch.schema().as_ref(), predicate);
+    if groups.len() <= 1 {
+        let mask = eval_bool_mask(batch, predicate)?;
+        return Ok(match mask {
+            None => batch.num_rows(),
+            Some(m) => count_mask_rows(batch, &m)?,
+        });
+    }
+    let mut current_mask: Option<BooleanArray> = None;
+    let mut surviving = batch.num_rows();
+    let last_idx = groups.len() - 1;
+    for (gidx, (cols, group_expr)) in groups.iter().enumerate() {
+        if surviving == 0 {
+            return Ok(0);
+        }
+        if let Some(mask) = &current_mask {
+            let sub_fields: Vec<_> = cols
+                .iter()
+                .map(|&i| batch.schema().field(i).clone())
+                .collect();
+            let sub_schema = Arc::new(Schema::new(sub_fields));
+            let sub_cols: Vec<_> = cols
+                .iter()
+                .map(|&i| filter_array(batch.column(i).as_ref(), mask))
+                .collect::<std::result::Result<_, _>>()?;
+            let sub_batch = RecordBatch::try_new(Arc::clone(&sub_schema), sub_cols)?;
+            let remapped =
+                reassign_expr_columns(Arc::clone(group_expr), &sub_schema)?;
+            if let Some(sub_mask) = eval_bool_mask(&sub_batch, &remapped)? {
+                surviving = sub_mask.true_count();
+                if surviving == 0 || gidx == last_idx {
+                    return Ok(surviving);
+                }
+                let mut builder = BooleanBufferBuilder::new(batch.num_rows());
+                builder.append_n(batch.num_rows(), false);
+                let mut sub_idx = 0usize;
+                for row_idx in mask.values().set_indices() {
+                    if mask.is_valid(row_idx) {
+                        if sub_mask.is_valid(sub_idx) && sub_mask.value(sub_idx) {
+                            builder.set_bit(row_idx, true);
+                        }
+                        sub_idx += 1;
+                    }
+                }
+                current_mask = Some(BooleanArray::new(builder.finish(), None));
+            }
+        } else if let Some(mask) = eval_bool_mask(batch, group_expr)? {
+            surviving = mask.true_count();
+            if surviving == 0 {
+                return Ok(0);
+            }
+            current_mask = Some(mask);
+        }
+    }
+    Ok(surviving)
+}
