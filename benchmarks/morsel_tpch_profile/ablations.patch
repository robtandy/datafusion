+fn group_and_order_conjuncts(
+    schema: &Schema,
+    predicate: &Arc<dyn PhysicalExpr>,
+) -> Vec<(Vec<usize>, Arc<dyn PhysicalExpr>)> {
+    let mut groups: Vec<(Vec<usize>, Vec<Arc<dyn PhysicalExpr>>)> = Vec::new();
+    for expr in split_conjunction(predicate) {
+        let mut cols: Vec<usize> = collect_columns(expr)
+            .into_iter()
+            .map(|c| c.index())
+            .collect();
+        cols.sort_unstable();
+        cols.dedup();
+        if let Some((_, list)) = groups.iter_mut().find(|(c, _)| *c == cols) {
+            list.push(Arc::clone(expr));
+        } else {
+            groups.push((cols, vec![Arc::clone(expr)]));
+        }
+    }
+    // Order cheapest / narrowest column groups first (Date32/Int32 before Decimal128).
+    groups.sort_by_key(|(cols, exprs)| {
+        let max_width: usize = cols
+            .iter()
+            .map(|&i| match schema.field(i).data_type() {
+                DataType::Decimal128(_, _) | DataType::Decimal256(_, _) => 16,
+                DataType::Int64 | DataType::UInt64 | DataType::Float64 => 8,
+                _ => 4,
+            })
+            .max()
+            .unwrap_or(0);
+        // Prefer multi-bound ranges (e.g. BETWEEN / date range) at the same width.
+        (max_width, std::cmp::Reverse(exprs.len()), cols.len())
+    });
+    groups
+        .into_iter()
+        .map(|(cols, exprs)| (cols, conjunction(exprs)))
+        .collect()
+}
